+// 12 s cycle: 2 s right, 3 s still, 2 s left, 2 s up, 2 s down, 1 s still (40 degrees/s).
+void SDL3InputDriver::State::FeedTestGyro() {
+  if (!test_joystick) {
+    return;
+  }
+  constexpr float kRate = 40.0f * 3.14159265f / 180.0f;
+  const u64 phase = SDL_GetTicks() % 12000;
+  float data[3] = {0.0f, 0.0f, 0.0f};
+  if (phase < 2000) {
+    data[1] = -kRate;
+  } else if (phase >= 5000 && phase < 7000) {
+    data[1] = kRate;
+  } else if (phase >= 7000 && phase < 9000) {
+    data[0] = kRate;
+  } else if (phase >= 9000 && phase < 11000) {
+    data[0] = -kRate;
+  }
+  SDL_SendJoystickVirtualSensorData(test_joystick, SDL_SENSOR_GYRO, SDL_GetTicksNS(), data, 3);
+
+  // Button script for testing: EDEN_PAD_SCRIPT="ms:button:duration_ms,..." (ms since SDL
+  // started). Buttons: start, a, b, x, y, up, down, left, right.
+  struct Step {
+    u64 at;
+    u64 until;
+    SDL_GamepadButton button;
+  };
+  static const std::vector<Step> script = [] {
+    std::vector<Step> steps;
+    const char* env = SDL_getenv("EDEN_PAD_SCRIPT");
+    std::string text = env ? env : "";
+    size_t pos = 0;
+    while (pos < text.size()) {
+      const size_t end = std::min(text.find(',', pos), text.size());
+      const std::string item = text.substr(pos, end - pos);
+      pos = end + 1;
+      const size_t c1 = item.find(':');
+      const size_t c2 = item.find(':', c1 == std::string::npos ? 0 : c1 + 1);
+      if (c1 == std::string::npos || c2 == std::string::npos) {
+        continue;
+      }
+      const std::string name = item.substr(c1 + 1, c2 - c1 - 1);
+      SDL_GamepadButton button = SDL_GAMEPAD_BUTTON_INVALID;
+      if (name == "start") button = SDL_GAMEPAD_BUTTON_START;
+      else if (name == "a") button = SDL_GAMEPAD_BUTTON_SOUTH;
+      else if (name == "b") button = SDL_GAMEPAD_BUTTON_EAST;
+      else if (name == "x") button = SDL_GAMEPAD_BUTTON_WEST;
+      else if (name == "y") button = SDL_GAMEPAD_BUTTON_NORTH;
+      else if (name == "up") button = SDL_GAMEPAD_BUTTON_DPAD_UP;
+      else if (name == "down") button = SDL_GAMEPAD_BUTTON_DPAD_DOWN;
+      else if (name == "left") button = SDL_GAMEPAD_BUTTON_DPAD_LEFT;
+      else if (name == "right") button = SDL_GAMEPAD_BUTTON_DPAD_RIGHT;
+      if (button == SDL_GAMEPAD_BUTTON_INVALID) {
+        continue;
+      }
+      const u64 at = std::strtoull(item.c_str(), nullptr, 10);
+      steps.push_back({at, at + std::strtoull(item.c_str() + c2 + 1, nullptr, 10), button});
+    }
+    return steps;
+  }();
+  if (!script.empty()) {
+    const u64 now = SDL_GetTicks();
+    bool down[SDL_GAMEPAD_BUTTON_COUNT] = {};
+    bool used[SDL_GAMEPAD_BUTTON_COUNT] = {};
+    for (const Step& step : script) {
+      used[step.button] = true;
+      down[step.button] = down[step.button] || (now >= step.at && now < step.until);
+    }
+    for (int i = 0; i < SDL_GAMEPAD_BUTTON_COUNT; ++i) {
+      if (used[i]) {
+        SDL_SetJoystickVirtualButton(test_joystick, static_cast<Uint8>(i), down[i]);
+      }
+    }
+  }
+}
