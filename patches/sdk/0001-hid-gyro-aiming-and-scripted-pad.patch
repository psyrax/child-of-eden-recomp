   }
   state_->QueuePump(state_);
   auto guard = state_->DrainAndLock();
-  const State::Controller* controller = state_->FindByID(id);
+  State::Controller* controller = state_->FindByID(id);
   if (!controller) {
     return std::unexpected(NotConnected());
