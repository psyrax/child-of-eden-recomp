+void SDL3InputDriver::State::OnSensorLocked(const SDL_Event& event) {
+  if (event.gsensor.sensor != SDL_SENSOR_GYRO) {
+    return;
+  }
+  Controller* controller = FindByInstance(event.gsensor.which);
+  if (!controller || !controller->gyro_on) {
+    return;
+  }
+  for (int i = 0; i < 3; ++i) {
+    controller->gyro_sum[i] += event.gsensor.data[i];
+  }
+  ++controller->gyro_samples;
+}
