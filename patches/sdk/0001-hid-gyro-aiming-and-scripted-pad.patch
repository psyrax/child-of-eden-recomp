-  return controller->state;
+  PadState pad = controller->state;
+  if (!controller->has_gyro) {
+    return pad;
+  }
+  const bool want = gyro.Get();
+  if (want != controller->gyro_on) {
+    if (!SDL_SetGamepadSensorEnabled(controller->sdl, SDL_SENSOR_GYRO, want)) {
+      REXHID_WARN("SDL: cannot switch the gyroscope: {}", SDL_GetError());
+      controller->has_gyro = false;
+      return pad;
+    }
+    REXHID_INFO("SDL: gyroscope {}", want ? "on" : "off");
+    controller->gyro_on = want;
+    controller->gyro_samples = 0;
+    for (int i = 0; i < 3; ++i) {
+      controller->gyro_sum[i] = 0.0;
+      controller->gyro_rate[i] = 0.0;
+    }
+  }
+  if (!controller->gyro_on) {
+    return pad;
+  }
+  // Average of the samples received since the previous read; if the sensor is silent for 100 ms, zero.
+  const u64 now = SDL_GetTicks();
+  if (controller->gyro_samples > 0) {
+    for (int i = 0; i < 3; ++i) {
+      controller->gyro_rate[i] = controller->gyro_sum[i] / controller->gyro_samples;
+      controller->gyro_sum[i] = 0.0;
+    }
+    controller->gyro_samples = 0;
+    controller->gyro_tick = now;
+  } else if (now - controller->gyro_tick > 100) {
+    return pad;
+  }
+  // SDL axes: x pitch (positive points up), y yaw (positive turns left),
+  // z roll (positive lowers the left side). Stick: x positive right, y positive up.
+  constexpr f64 kPi = 3.14159265358979323846;
+  constexpr f64 kFullRate = kPi / 2.0;
+  f64 x = -(controller->gyro_rate[1] + gyro_roll.Get() * controller->gyro_rate[2]);
+  f64 y = controller->gyro_rate[0];
+  if (gyro_invert_x.Get()) {
+    x = -x;
+  }
+  if (gyro_invert_y.Get()) {
+    y = -y;
+  }
+  const f64 rate = std::hypot(x, y);
+  const f64 deadzone = gyro_deadzone.Get() * kPi / 180.0;
+  if (rate <= deadzone || rate <= 0.0) {
+    return pad;
+  }
+  const f64 floor = gyro_min_output.Get();
+  const f64 level = std::min(1.0, (rate - deadzone) / kFullRate * gyro_sensitivity.Get());
+  const f64 scale = (floor + (1.0 - floor) * level) / rate * 32767.0;
+  i16& stick_x = gyro_right_stick.Get() ? pad.thumb_rx : pad.thumb_lx;
+  i16& stick_y = gyro_right_stick.Get() ? pad.thumb_ry : pad.thumb_ly;
+  stick_x = static_cast<i16>(std::clamp(stick_x + x * scale, -32768.0, 32767.0));
+  stick_y = static_cast<i16>(std::clamp(stick_y + y * scale, -32768.0, 32767.0));
+  return pad;
 }
 
