+u64 SharedMemory::EdenChecksum(u32 page) {
+  const u64* p = reinterpret_cast<const u64*>(
+      GetPhysicalForRead(GetMemory(), page << page_size_log2_, 1u << page_size_log2_));
+  if (!p) {
+    return 0;
+  }
+  u64 h = 1469598103934665603ull;
+  for (u32 i = 0; i < (1u << page_size_log2_) / 8; ++i) {
+    h = (h ^ p[i]) * 1099511628211ull;
+  }
+  return h | 1;
+}
+
+void SharedMemory::EdenWatch(u64 frame) {
+  auto lock = AcquireLock();
+  if (eden_checksums_.empty()) {
+    return;
+  }
+  u32 changed = 0, live = 0, first = 0, last = 0;
+  for (size_t b = 0; b < system_page_flags_valid_and_gpu_written_.size(); ++b) {
+    u64 bits = system_page_flags_valid_and_gpu_written_[b];
+    while (bits) {
+      const u32 bit = static_cast<u32>(__builtin_ctzll(bits));
+      bits &= bits - 1;
+      const u32 page = static_cast<u32>(b * 64 + bit);
+      ++live;
+      const u64 now = EdenChecksum(page);
+      if (eden_checksums_[page] && eden_checksums_[page] != now) {
+        if (!changed) {
+          first = page;
+        }
+        last = page;
+        ++changed;
+      }
+      eden_checksums_[page] = now;
+    }
+  }
+  if (changed) {
+    REXGPU_WARN("eden watch: frame {}: {} of {} GPU-written pages changed on the CPU without notice; "
+                "physical {:08X} to {:08X}",
+                frame, changed, live, first << page_size_log2_, last << page_size_log2_);
+  }
+}
+
+void SharedMemory::EdenInvalidateAll() {
+  FireWatches(0, (kBufferSize - 1) >> page_size_log2_, false);
+  auto lock = AcquireLock();
+  std::fill(system_page_flags_valid_.begin(), system_page_flags_valid_.end(), 0);
+  std::fill(system_page_flags_valid_and_gpu_written_.begin(),
+            system_page_flags_valid_and_gpu_written_.end(), 0);
+}
