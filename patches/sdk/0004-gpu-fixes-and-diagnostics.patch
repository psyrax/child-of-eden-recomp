+// eden: stutter diagnostics, always on and cheap. Logs every frame that takes much longer than
+// the average (with how many pipelines were compiled meanwhile) and a summary per minute. Line cap per session.
+extern std::atomic<unsigned long long> eden_diag_pipelines;
+extern std::atomic<unsigned long long> eden_diag_pipelines_us;
+extern std::atomic<unsigned long long> eden_diag_upload_bytes;
+extern std::atomic<unsigned long long> eden_diag_upload_calls;
+namespace {
+void EdenDiagFrame() {
+  using Clock = std::chrono::steady_clock;
+  static Clock::time_point before = Clock::now(), minute = before;
+  static double avg_ms = 16.7, worst_ms = 0.0, sum_ms = 0.0;
+  static unsigned long long pl_before = 0, us_before = 0, pl_minute = 0;
+  static unsigned frames = 0, stutters = 0, lines = 0, total = 0;
+  const Clock::time_point now = Clock::now();
+  const double ms = std::chrono::duration<double, std::milli>(now - before).count();
+  before = now;
+  const unsigned long long pl = eden_diag_pipelines.load(std::memory_order_relaxed);
+  const unsigned long long us = eden_diag_pipelines_us.load(std::memory_order_relaxed);
+  ++total;
+  if (total > 120 && ms < 2000.0) {
+    if (ms > 25.0 && ms > 1.6 * avg_ms) {
+      ++stutters;
+      if (lines < 1500) {
+        ++lines;
+        REXGPU_WARN("diag: stutter of {:.0f} ms (avg {:.1f}); pipelines compiled meanwhile: {} ({:.0f} ms)", ms,
+                    avg_ms, pl - pl_before, (us - us_before) / 1000.0);
+      }
+    } else {
+      avg_ms += 0.02 * (ms - avg_ms);
+    }
+    ++frames;
+    sum_ms += ms;
+    if (ms > worst_ms) worst_ms = ms;
+  }
+  pl_before = pl;
+  us_before = us;
+  if (now - minute >= std::chrono::seconds(60)) {
+    if (frames) {
+      static unsigned long long sb_minute = 0, sl_minute = 0;
+      const unsigned long long sb = eden_diag_upload_bytes.load(std::memory_order_relaxed);
+      const unsigned long long sl = eden_diag_upload_calls.load(std::memory_order_relaxed);
+      REXGPU_INFO("diag: last minute: {:.1f} fps, worst frame {:.0f} ms, stutters {}, pipelines {}, "
+                  "upload {:.2f} MB and {:.0f} calls per frame",
+                  1000.0 * frames / sum_ms, worst_ms, stutters, pl - pl_minute,
+                  (sb - sb_minute) / 1048576.0 / frames, static_cast<double>(sl - sl_minute) / frames);
+      sb_minute = sb;
+      sl_minute = sl;
+    }
+    minute = now;
+    pl_minute = pl;
+    frames = stutters = 0;
+    worst_ms = sum_ms = 0.0;
+  }
+}
