+      }
+      ++row_index;
+      // "###" keeps the item's identity when its text changes, so the focus stays on the row.
+      int delta = ImGui::Button((text + "###row").c_str(), ImVec2(-1.0f, 0.0f)) ? 1 : 0;
+      if (ImGui::IsItemFocused()) {
+        if (ImGui::IsKeyPressed(ImGuiKey_GamepadDpadRight, false)) {
+          delta = 1;
+        } else if (ImGui::IsKeyPressed(ImGuiKey_GamepadDpadLeft, false)) {
+          delta = -1;
+        }
+      }
+      ImGui::PopID();
+      return delta;
+    };
+    const auto text_of = [&](std::string_view name) -> std::optional<std::string> {
+      auto var = settings_.Find(name);
+      return var && *var ? std::optional<std::string>((*var)->GetText()) : std::nullopt;
+    };
+    const auto set = [&](std::string_view name, std::string_view text) {
+      WarnIfFailed(name, settings_.SetText(name, text));
+      quit_armed_ = false;
+      // No "save" step for the player: every change goes to the config file.
+      if (auto status = settings_.Save(config_path_); !status) {
+        REXUI_ERROR("{}", status.error().GetDescription());
+        notice_ = tr.save_failed;
+      }
+    };
+    const auto restarts = [&](std::string_view name) {
+      auto var = settings_.Find(name);
+      if (var && *var && (*var)->GetConstraints().life != rex::SettingLife::kLive) {
+        notice_ = tr.restart_needed;
+      } else {
+        notice_.clear();
+      }
+    };
+    // One row that cycles a setting through fixed choices. Numbers compare as numbers.
+    const auto choice = [&](const char* label, std::span<const char* const> names,
+                            std::span<const SimpleChoice> choices) {
+      const auto current = text_of(names[0]);
+      if (!current) {
+        return;
+      }
+      size_t at = choices.size();
+      for (size_t i = 0; i < choices.size(); ++i) {
+        char* end = nullptr;
+        const f64 a = std::strtod(current->c_str(), &end);
+        const bool numeric = end != current->c_str() && *end == '\0';
+        if (*current == choices[i].value ||
+            (numeric && std::fabs(a - std::strtod(choices[i].value, nullptr)) < 1e-6 &&
+             std::strtod(choices[i].value, &end) == std::strtod(choices[i].value, nullptr) &&
+             end != choices[i].value)) {
+          at = i;
+          break;
+        }
+      }
+      const char* shown = at < choices.size() ? choices[at].label : current->c_str();
+      const int delta = row(std::format("{}:   < {} >", label, shown), names[0]);
+      if (delta == 0) {
+        return;
+      }
+      const size_t count = choices.size();
+      const size_t next = at >= count ? 0 : (at + count + static_cast<size_t>(delta + static_cast<int>(count))) % count;
+      for (const char* name : names) {
+        set(name, choices[next].value);
+      }
+      restarts(names[0]);
+    };
+    // One row that moves a number in steps and shows it as a percentage.
+    const auto percent = [&](const char* label, const char* name, f64 low, f64 high, f64 step) {
+      const auto current = text_of(name);
+      if (!current) {
+        return;
+      }
+      const f64 value = std::strtod(current->c_str(), nullptr);
+      const int delta = row(std::format("{}:   < {:.0f}% >", label, value * 100.0), name);
+      if (delta == 0) {
+        return;
+      }
+      f64 next = std::round((value + step * delta) / step) * step;
+      if (next > high + 1e-9) {
+        next = delta > 0 && ImGui::IsKeyDown(ImGuiKey_GamepadFaceDown) ? low : high;
+      }
+      next = std::clamp(next, low, high);
+      set(name, std::format("{:.2f}", next));
+      restarts(name);
+    };
+
+    if (row(tr.back, "back") != 0) {
+      ui_.ShowOverlay("settings", false);
+    }
+    ImGui::Separator();
+
+    {
+      // The word "Language" stays visible so the row can be found from any language.
+      std::vector<const MenuText*> usable;
+      size_t at = 0;
+      for (const MenuText& text : kMenuTexts) {
+        if (MenuTextUsable(text)) {
+          if (&text == &tr) {
+            at = usable.size();
+          }
+          usable.push_back(&text);
+        }
+      }
+      const std::string label = &tr == &kMenuTexts[0]
+                                    ? std::string(tr.language)
+                                    : std::format("{} (Language)", tr.language);
+      const int delta = row(std::format("{}:   < {} >", label, tr.name), "language");
+      if (delta != 0 && !usable.empty()) {
+        const size_t count = usable.size();
+        const size_t next = (at + count + static_cast<size_t>(delta + static_cast<int>(count))) % count;
+        set("ui.language", usable[next]->code);
+        // A notice in the old language would be out of place.
+        notice_.clear();
+      }
+    }
+
+    static constexpr const char* kFps[] = {"gpu.frame_limit"};
+    const SimpleChoice kFpsChoices[] = {
+        {"0", tr.fps_normal}, {"45", "45"}, {"40", "40"}, {"30", tr.fps_battery}};
+    choice(tr.fps, kFps, kFpsChoices);
+
+    static constexpr const char* kScale[] = {"gpu.resolution_scale_x", "gpu.resolution_scale_y"};
+    const SimpleChoice kScaleChoices[] = {
+        {"1", tr.quality_normal}, {"2", tr.quality_high}, {"3", tr.quality_very_high}};
+    choice(tr.quality, kScale, kScaleChoices);
+
+    static constexpr const char* kSmooth[] = {"gpu.xenos.swap_post_effect"};
+    const SimpleChoice kSmoothChoices[] = {
+        {"none", tr.no}, {"fxaa", tr.yes}, {"fxaa_extreme", tr.strong}};
+    choice(tr.smooth, kSmooth, kSmoothChoices);
+
+    const SimpleChoice kOnOff[] = {{"false", tr.no}, {"true", tr.yes}};
+    static constexpr const char* kMute[] = {"apu.mute"};
+    choice(tr.mute, kMute, kOnOff);
+    percent(tr.volume, "apu.gain", 0.0, 2.0, 0.1);
+
+    static constexpr const char* kGyro[] = {"hid.sdl.gyro"};
+    choice(tr.gyro, kGyro, kOnOff);
+    if (text_of("hid.sdl.gyro").value_or("false") == "true") {
+      const std::string sensitivity = std::format("   {}", tr.sensitivity);
+      const std::string invert_x = std::format("   {}", tr.invert_x);
+      const std::string invert_y = std::format("   {}", tr.invert_y);
+      percent(sensitivity.c_str(), "hid.sdl.gyro_sensitivity", 0.2, 4.0, 0.2);
+      static constexpr const char* kGyroX[] = {"hid.sdl.gyro_invert_x"};
+      static constexpr const char* kGyroY[] = {"hid.sdl.gyro_invert_y"};
+      choice(invert_x.c_str(), kGyroX, kOnOff);
+      choice(invert_y.c_str(), kGyroY, kOnOff);
+    }
+
+    ImGui::Separator();
+    if (row(tr.counter, "counter") != 0) {
+      ui_.ToggleOverlay("debug");
+    }
+    if (row(tr.advanced, "advanced") != 0) {
+      advanced_ = true;
+    }
+    if (row(quit_armed_ ? tr.quit_confirm : tr.quit, "quit") != 0) {
+      if (quit_armed_) {
+        ui_.RequestQuit();
+      }
+      quit_armed_ = !quit_armed_;
+    }
+
+    ImGui::Separator();
+    if (!notice_.empty()) {
+      ImGui::TextWrapped("%s", notice_.c_str());
+    }
+    ImGui::TextDisabled("%s", tr.hint);
+  }
+  ImGui::End();
+  ImGui::PopStyleVar(4);
+  return keep;
+}
