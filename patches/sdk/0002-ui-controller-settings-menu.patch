+// Japanese is only offered when the font can draw it.
+bool MenuTextUsable(const MenuText& text) {
+  if (std::string_view(text.code) != "ja") {
+    return true;
+  }
+  ImFont* font = ImGui::GetFont();
+  return font && font->IsGlyphInFont(static_cast<ImWchar>(0x8A2D)) &&
+         font->IsGlyphInFont(static_cast<ImWchar>(0x3042));
+}
+
+const MenuText& MenuTextFor(std::string_view code) {
+  for (const MenuText& text : kMenuTexts) {
+    if (code == text.code && MenuTextUsable(text)) {
+      return text;
+    }
+  }
+  return kMenuTexts[0];
+}
