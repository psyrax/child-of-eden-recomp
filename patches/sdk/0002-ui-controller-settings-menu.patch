+
+void UISystem::State::TogglePadMenu() {
+  if (!overlays) {
+    return;
+  }
+  const bool shown = IsSettingsVisible();
+  if (shown && !pad_menu.load()) {
+    // Opened from the keyboard: take it over instead of closing it.
+    pad_menu = true;
+    SyncOverlayBlock();
+    return;
+  }
+  pad_menu = !shown;
+  overlays->Show("settings", !shown);
+  SyncOverlayBlock();
+  REXUI_INFO("pad menu {}", pad_menu.load() ? "opened" : "closed");
+}
